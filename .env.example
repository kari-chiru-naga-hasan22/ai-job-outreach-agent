# OpenRouter Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Slug for "OX Alpha" (stealth reasoning model):
# Other options: stealth/ox-alpha, openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_ID=stealth/ox-alpha

# Optional: Server Port
PORT=8000
